{
  "name": "portofolio1",
  "private": true,
  "description": "Personal portfolio site of Nicholaus Ardian Nugraha",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint \"**/*.css\"",
    "lint": "npm run format:check && npm run lint:html && npm run lint:css",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.1",
    "html-validate": "11.21.1",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0"
  }
}
